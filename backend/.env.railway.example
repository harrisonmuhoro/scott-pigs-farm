# Set these in Railway Variables. Do not commit real credentials.
SCOTT_APP_ENV=production
SCOTT_TIMEZONE=Africa/Nairobi
SCOTT_ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app
SCOTT_SESSION_SAMESITE=None

# You can either map Railway's MYSQL* variables to these SCOTT_* names,
# or leave them unset and db.php will use Railway's injected MYSQL* values.
SCOTT_DB_HOST=
SCOTT_DB_PORT=
SCOTT_DB_NAME=
SCOTT_DB_USER=
SCOTT_DB_PASSWORD=
